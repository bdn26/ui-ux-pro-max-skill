{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "qwen-image": {
      "command": "python3",
      "args": ["mcp-tools/qwen-image/server.py"],
      "env": { "MUAPI_API_KEY": "${MUAPI_API_KEY}" }
    }
  }
}
